# Read git's list of pushed refs first, before any command can consume stdin.
refs=$(cat)

# Install exactly what pnpm-lock.yaml pins before any gate below runs
# against node_modules. Frozen so a push never rewrites the lockfile.
pnpm install --frozen-lockfile || {
  echo "pnpm install --frozen-lockfile failed (see the pnpm output above). If it reports ERR_PNPM_OUTDATED_LOCKFILE, pnpm-lock.yaml is out of date with package.json: run 'pnpm install' and commit the update. Otherwise this is an install problem (network, registry auth, disk), not a lockfile problem." >&2
  exit 1
}

pnpm type-check
pnpm lint
pnpm format:check
pnpm test:coverage
pnpm test:e2e --project=chromium

# Skip only on a clear "no" (exit 1). Any other failure runs the tests.
status=0
printf '%s\n' "$refs" | scripts/visual-changed.sh || status=$?
if [ "$status" -eq 1 ]; then
  echo "Visual tests skipped: this push changes no file that can move a baseline."
else
  pnpm test:visual
fi
