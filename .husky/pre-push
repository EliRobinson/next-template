# Read git's list of pushed refs first, before any command can consume stdin.
refs=$(cat)

# Keep dependencies current before any gate below runs against them. Frozen
# so a push never rewrites the lockfile; a stale lockfile fails the push
# instead of silently drifting.
pnpm install --frozen-lockfile || {
  echo "pnpm-lock.yaml is out of date with package.json. Run 'pnpm install' and commit the updated lockfile before pushing." >&2
  exit 1
}

pnpm type-check
pnpm lint
pnpm format:check
pnpm test:coverage
pnpm test:e2e --project=chromium

# Skip only on a clear "no" (exit 1). Any other failure runs the tests.
status=0
printf '%s\n' "$refs" | scripts/visual-changed.sh || status=$?
if [ "$status" -eq 1 ]; then
  echo "Visual tests skipped: this push changes no file that can move a baseline."
else
  pnpm test:visual
fi
