# Copy this file to .env.local and fill in values.
# Never commit .env.local.
# All vars are validated in src/env.ts — the app will refuse to start/build
# if a required one is missing.

# Only needed if this project uses a database (see src/server/db).
# DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# The GitHub Packages credential does NOT belong here. Installing
# @elirobinson/* needs the scope mapping and a PAT with read:packages in the
# npm config, and pnpm never reads an env var here for it. Set both once at
# the user level instead, in ~/.npmrc:
#
#   @elirobinson:registry=https://npm.pkg.github.com
#   //npm.pkg.github.com/:_authToken=<your-PAT>
#
# See docs/agents/environment.md, "GitHub Packages token".
