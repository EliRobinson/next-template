# Copy this file to .env.local and fill in values.
# Never commit .env.local.
# All vars are validated in src/env.ts — the app will refuse to start/build
# if a required one is missing.

# Only needed if this project uses a database (see src/server/db).
# DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# GitHub PAT (read:packages scope) to install @elirobinson/tokens,
# @elirobinson/react and @elirobinson/ai-patterns — the design system this
# template builds all UI from (see docs/design-system.md) — from the private
# GitHub Packages registry.
# Not read by src/env.ts — export it before running pnpm install, e.g.:
#   export $(grep -v '^#' .env.local | xargs)
# NODE_AUTH_TOKEN="ghp_..."
