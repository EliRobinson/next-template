# Copy this file to .env.local and fill in values.
# Never commit .env.local.
# All vars are validated in src/env.ts — the app will refuse to start/build
# if a required one is missing.

# Only needed if this project uses a database (see src/server/db).
# DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# The GitHub Packages credential does NOT belong here. Installing
# @elirobinson/* needs a PAT with read:packages, but pnpm 10+ ignores
# credentials that come from a committed project .npmrc, so an env var here
# would never reach the registry. Set it once at the user level instead:
#
#   pnpm config set "//npm.pkg.github.com/:_authToken" <your-PAT> --global
#
# See the README, "Authenticate to GitHub Packages".
