{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Agent|Task|mcp__.*create_pull_request.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks/review-gate.mjs\" --agent=claude"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "review-.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks/review-gate.mjs\" --agent=claude"
          }
        ]
      }
    ]
  }
}
